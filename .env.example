# Global Environment Variables
NODE_ENV=development
ENVIRONMENT=development

# JWT Secret (Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Gateway
API_GATEWAY_PORT=3000

# User Service (Python/FastAPI)
USER_SERVICE_PORT=8001
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/userdb

# Product Service (Java/Spring Boot)
PRODUCT_SERVICE_PORT=8002
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/productdb
SPRING_DATASOURCE_USERNAME=mysql
SPRING_DATASOURCE_PASSWORD=mysql123

# Order Service (Go/Gin)
ORDER_SERVICE_PORT=8003
MONGODB_URI=mongodb://mongo:mongo123@mongodb:27017/orderdb?authSource=admin

# Notification Service (Node.js)
NOTIFICATION_SERVICE_PORT=8004

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_URL=amqp://rabbit:rabbit123@rabbitmq:5672/
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=rabbit
SPRING_RABBITMQ_PASSWORD=rabbit123

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/

# Database Credentials
POSTGRES_DB=userdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

MYSQL_ROOT_PASSWORD=mysql123
MYSQL_DATABASE=productdb
MYSQL_USER=mysql
MYSQL_PASSWORD=mysql123

MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo123
MONGO_INITDB_DATABASE=orderdb

# RabbitMQ Management
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit123

# Security
SESSION_SECRET=your-session-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# External Services
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004